{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "supabase/**",
      "SUPABASE_SETUP.md",
      "firebase-config.js",
      "tests/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "schools.json",
      "README.md"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "ui": { "enabled": false }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
